{
  "name": "brainmerge",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/check-locales.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "verify": "npm test",
    "audit:release": "node scripts/release-audit.mjs",
    "package": "npm run build && PLATFORM=local node scripts/package-portal.mjs && node scripts/check-package.mjs local && npm run audit:release",
    "package:yandex": "npm run build && PLATFORM=yandex node scripts/package-portal.mjs && node scripts/check-package.mjs yandex && npm run audit:release",
    "smoke:runtime": "node scripts/runtime-smoke.mjs",
    "smoke:campaign": "node scripts/campaign-shell-smoke.mjs",
    "smoke:campaign:final": "node scripts/campaign-restore-mastery-smoke.mjs",
    "smoke:rc": "node scripts/rc-smoke.mjs",
    "smoke:motion": "node scripts/motion-smoke.mjs",
    "smoke:locale": "node scripts/locale-runtime-smoke.mjs",
    "smoke:yandex": "node scripts/yandex-browser-smoke.mjs",
    "serve": "python3 -m http.server 4173"
  },
  "devDependencies": {
    "playwright": "^1.55.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}